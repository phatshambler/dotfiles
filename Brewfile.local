# Personal additions, installed after homebrew/Brewfile.base and the role Brewfiles.
cask_args appdir: '/Applications'

tap 'hashicorp/tap'
tap 'shivammathur/php'

brew 'bat'
brew 'curl'
brew 'eza'
brew 'fish'
brew 'fzf'
brew 'git-delta'
brew 'hashicorp/tap/packer'
brew 'numpy'
brew 'php@8.3'
brew 'php@8.4'
brew 'pyenv'
brew 'shivammathur/php/php@7.4'
brew 'tlrc'
brew 'zoxide'

cask 'arduino-ide'
cask 'blender'
cask 'discord'
cask 'handbrake-app'
cask 'hex-fiend'
cask 'http-toolkit'
cask 'insomnia'
cask 'physicseditor'
cask 'qlab'
cask 'slack'
cask 'teamviewer'

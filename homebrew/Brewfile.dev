# Developers: CLI tools, languages, databases and dev apps.
cask_args appdir: '/Applications'

tap 'hashicorp/tap'

brew 'ansible'
brew 'awscli'
brew 'composer'
brew 'dockutil'
brew 'ffmpeg'
brew 'lame'
brew 'gh'
brew 'glab'
brew 'git'
brew 'git-lfs'
brew 'go'
brew 'hashicorp/tap/terraform'
brew 'helm'
brew 'imagemagick'
brew 'jq'
brew 'kubectl'
brew 'mysql'
brew 'openssl'
brew 'php'
brew 'postgresql'
brew 'python'
brew 'rbenv'
brew 'ripgrep'
brew 'ruby-build'
brew 'transmission-cli'
brew 'uv'
brew 'wakeonlan'
brew 'yt-dlp'
brew 'wget'
brew 'neovim'

cask '1password-cli'
cask 'cyberduck'
cask 'docker-desktop'
cask 'gcloud-cli'
cask 'ghostty'
cask 'loopback'
cask 'obs'
cask 'poedit'
cask 'postman'
cask 'tableplus'
cask 'texturepacker'
cask 'visual-studio-code'
cask 'figma'
cask 'harvest'
cask 'rectangle'
cask 'vlc'